# PostgreSQL connection string (e.g. from Neon, Supabase, Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geoviz?sslmode=require"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..." # one-time price for $97 AI Visibility Audit (early-customer pricing; was $147)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend
RESEND_API_KEY="re_..."
# Preferred from-address for outgoing email (canonical name).
RESEND_EMAIL_FROM="GeoViz <orders@yourdomain.com>"
# Address that receives admin notifications when a Stripe checkout completes.
AUDIT_NOTIFICATION_EMAIL="you@yourdomain.com"
# Gate for the verify-system test-email step (does not affect webhook emails).
SEND_EMAILS="false"
# Legacy aliases (older code reads these as fallbacks).
RESEND_FROM_EMAIL="GeoViz <orders@yourdomain.com>"
ADMIN_NOTIFY_EMAIL="you@yourdomain.com"

# Admin
ADMIN_PASSWORD="change-me-strong"
