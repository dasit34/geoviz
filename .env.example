# PostgreSQL connection string (e.g. from Neon, Supabase, Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geoviz?sslmode=require"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..." # one-time price for $97 AI Visibility Audit (early-customer pricing; was $147)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is intentionally NOT required.
# GeoViz uses server-side Stripe Checkout Sessions and redirects via
# the session URL, so the publishable key is never needed in the
# browser. Only add this if you ever embed Stripe Elements / Payment
# Element directly on a GeoViz page.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend
RESEND_API_KEY="re_..."
# Preferred from-address for outgoing email (canonical name).
RESEND_EMAIL_FROM="GeoViz <orders@yourdomain.com>"
# Address that receives admin notifications when a Stripe checkout completes.
AUDIT_NOTIFICATION_EMAIL="you@yourdomain.com"
# Gate for the verify-system test-email step (does not affect webhook emails).
SEND_EMAILS="false"
# Legacy aliases (older code reads these as fallbacks).
RESEND_FROM_EMAIL="GeoViz <orders@yourdomain.com>"
ADMIN_NOTIFY_EMAIL="you@yourdomain.com"
# Required by env validator (src/lib/env.ts). EMAIL_FROM is the last-resort
# fallback for the outgoing from-address; EMAIL_TO is the destination used by
# the `verify-system` health-check script. Set both or boot will fail.
EMAIL_FROM="GeoViz <orders@yourdomain.com>"
EMAIL_TO="you@yourdomain.com"

# Anthropic — required. The audit worker calls the Anthropic API directly when
# GEO_AUDIT_MODE=api (the production default). Validated to start with sk-ant-
# in src/lib/env.ts; missing this will fail boot.
ANTHROPIC_API_KEY="sk-ant-..."

# Audit worker mode. "api" (default, production-safe) calls the Anthropic SDK
# directly. "cli" shells out to scripts/run-geo-audit.sh, which requires the
# Claude Code CLI on PATH and is local-only — never set this in production.
GEO_AUDIT_MODE="api"

# Admin
ADMIN_PASSWORD="change-me-strong"
# Shared secret for /admin/reports and /api/admin/orders/* (?key= query string).
# Distinct from ADMIN_PASSWORD: the older /admin page uses ADMIN_PASSWORD via
# cookie auth; the newer /admin/reports dashboard and admin API routes use
# ADMIN_SECRET. Set both.
ADMIN_SECRET="change-me-strong-random-secret"
