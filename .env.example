# PostgreSQL connection string (e.g. from Neon, Supabase, Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geoviz?sslmode=require"
# Production-database safety guard (scripts/lib/nonprod-db-guard.ts,
# scripts/guard-build-database.ts). Fail-closed: tests, seeds, replay,
# backfill/repair scripts, `npm run dev`, db:push/db:studio, and every
# non-production build REFUSE any DATABASE_URL that is not loopback or
# listed here. Comma-separated "host" or "host:port" entries.
GEOVIZ_NONPROD_DB_HOSTS=""
# Optional explicit deny-list (always refused, beats the allowlist).
GEOVIZ_PRODUCTION_DB_HOSTS=""
# Break-glass for ONE deliberate ops run against production — set to the
# exact script name (e.g. replay-audits). Never works for tests or dev.
# Leave unset.
GEOVIZ_ALLOW_PRODUCTION_DB=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..." # one-time price for $97 AI Visibility Audit (early-customer pricing; was $147)
# One-time price for the $59 GeoViz Re-Audit (src/app/api/checkout/re-audit/route.ts).
# Purchase is gated server-side — only available for a prior paid, completed,
# admin-approved audit (see src/lib/audit-orders/reaudit-eligibility.ts).
STRIPE_REAUDIT_PRICE_ID="price_..."
# Subscription monitoring (src/lib/monitoring/plans.ts). A RECURRING Stripe
# price for the monthly monitoring plan — the amount lives in Stripe, never
# in code; an unset var means the plan is not offered. Only used when
# GEO_MODULE_MONITORING_ENABLED="true".
STRIPE_MONITORING_MONTHLY_PRICE_ID=""
# Max scheduled re-audits one scheduler tick may queue (default 3) — keeps
# the single worker from being flooded. `npm run monitoring:scheduler`.
MONITORING_SCHEDULER_MAX_PER_TICK=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is intentionally NOT required.
# GeoViz uses server-side Stripe Checkout Sessions and redirects via
# the session URL, so the publishable key is never needed in the
# browser. Only add this if you ever embed Stripe Elements / Payment
# Element directly on a GeoViz page.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend
RESEND_API_KEY="re_..."
# Preferred from-address for outgoing email (canonical name).
RESEND_EMAIL_FROM="GeoViz <orders@yourdomain.com>"
# Address that receives admin notifications when a Stripe checkout completes.
AUDIT_NOTIFICATION_EMAIL="you@yourdomain.com"
# Gate for the verify-system test-email step (does not affect webhook emails).
SEND_EMAILS="false"
# Legacy aliases (older code reads these as fallbacks).
RESEND_FROM_EMAIL="GeoViz <orders@yourdomain.com>"
ADMIN_NOTIFY_EMAIL="you@yourdomain.com"
# Required by env validator (src/lib/env.ts). EMAIL_FROM is the last-resort
# fallback for the outgoing from-address; EMAIL_TO is the destination used by
# the `verify-system` health-check script. Set both or boot will fail.
EMAIL_FROM="GeoViz <orders@yourdomain.com>"
EMAIL_TO="you@yourdomain.com"

# Anthropic — required. The audit worker calls the Anthropic API directly when
# GEO_AUDIT_MODE=api (the production default). Validated to start with sk-ant-
# in src/lib/env.ts; missing this will fail boot.
ANTHROPIC_API_KEY="sk-ant-..."

# Audit worker mode. "api" (default, production-safe) calls the Anthropic SDK
# directly. "cli" shells out to scripts/run-geo-audit.sh, which requires the
# Claude Code CLI on PATH and is local-only — never set this in production.
GEO_AUDIT_MODE="api"

# V2 Stage 2 — Render intelligence (OPTIONAL, disabled by default).
# When "true", the post-audit pipeline runs a headless Chromium pass
# against the audited URL to capture rendered-vs-raw deltas. NEVER
# blocks audit completion; render failure is logged and ignored.
# See src/lib/intelligence/render/renderIntelligence.ts.
GEO_RENDER_ENABLED="false"
# Hard timeout for the render pass in milliseconds. Clamped to
# [1000, 60000] at read time. Default 10s.
GEO_RENDER_TIMEOUT_MS="10000"

# Observation layer shadow flag. When "true", the orchestrator's
# enabled providers fire (currently mocked — no real API calls until
# providers are wired in a future PR). Default "false" — scoring
# path is unaffected either way.
# See src/lib/observations/index.ts:isObservationEnabled.
ENABLE_OBSERVATION="false"
# Per-provider API keys. A provider is "enabled" only when
# ENABLE_OBSERVATION=true AND its key is set to a non-empty string.
# Claude reuses ANTHROPIC_API_KEY (already configured for the worker).
OPENAI_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# Intelligence Engine Phase 1 — persistent evidence layer (OPTIONAL,
# disabled by default). When "true", normalizes the AI validator
# layer's already-real per-provider output (which runs unconditionally
# on every paid audit regardless of this flag) into the queryable
# Observation / QueryLibraryEntry / ObservationCompetitorMention
# tables. Adds ZERO new LLM calls — pure read-and-persist over data
# already captured earlier in the same request. Fail-soft: a failure
# here only logs a `[evidence] persist failed ...` warning and never
# affects the customer report. See
# src/lib/intelligence/evidence/persistObservationEvidence.ts and
# docs/INTELLIGENCE_ENGINE_GAP_ANALYSIS.md.
GEO_EVIDENCE_LAYER_ENABLED="false"

# Admin
ADMIN_PASSWORD="change-me-strong"
# Shared secret for /admin/reports and /api/admin/orders/* (?key= query string).
# Distinct from ADMIN_PASSWORD: the older /admin page uses ADMIN_PASSWORD via
# cookie auth; the newer /admin/reports dashboard and admin API routes use
# ADMIN_SECRET. Set both.
ADMIN_SECRET="change-me-strong-random-secret"

# ── AI validators (scaffold; disabled by default) ─────────────────────
# Cross-model interpretation checks that run AFTER the deterministic
# score is produced. LLMs do NOT create the GeoViz score — the
# deterministic engine in src/lib/scoring/ remains canonical. Validators
# ask AI systems how they interpret the business (can they identify
# services, service area; would they recommend the business; what facts
# are missing).
#
# CURRENT STATE: scaffold only. Every provider returns mocked output
# regardless of these env values — no real API calls happen. Real
# Per-provider keys. Each provider self-skips with status: "unavailable"
# when its key is missing — there is no master enable flag.
#   ANTHROPIC_API_KEY  — already declared above; reused by ClaudeValidator.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""
#
# GoogleAIOverviewValidator has no public API — permanent placeholder.
# It is always status: "unavailable" and reads no env var.

# ── Internal lead generation (admin-only; disabled by default) ─────────
# Business-discovery provider for the internal /admin/leads prospecting
# tool (see src/lib/discovery/). Nothing is purchased/activated by
# deploying this code — GooglePlacesProvider.enabled() gates on this key
# being set, same pattern as the AI validators above. Unset = inert;
# the discover route returns a clean "not configured" response.
GOOGLE_PLACES_API_KEY=""
# Hard per-request cap + rolling-24h spend guardrail for the discovery
# route (see src/app/api/admin/leads/discover/route.ts). Optional —
# defaults to 200 / 50 respectively when unset.
LEAD_DISCOVERY_MAX_RESULTS=""
LEAD_DISCOVERY_MAX_REQUESTS_PER_DAY=""
#
# Phase 3 — Outscraper is the first real discovery + contact-
# enrichment provider (src/lib/discovery/providers/outscraper.ts,
# src/lib/enrichment/providers/outscraper.ts). Nothing is purchased/
# activated by this key being unset — both providers' enabled() gate
# on it, same pattern as GOOGLE_PLACES_API_KEY above. Set it in your
# deployment environment / local .env, never here.
OUTSCRAPER_API_KEY=""
#
# Phase 4 — Instantly is the first outbound-email provider
# (src/lib/outbound/providers/instantly.ts) for the "Send to
# Instantly" bulk action on /admin/leads. Nothing is purchased/
# activated by this key being unset — enabled() gates on it, same
# pattern as OUTSCRAPER_API_KEY above. Server-side only; never sent to
# the browser. Set it in your deployment environment / local .env,
# never here.
INSTANTLY_API_KEY=""

# ── Daily Market Study automation (disabled by default) ─────────────────
# Runs the existing Market Study bulk-audit workflow once a day:
# discover -> qualify -> exclude -> enqueue on the existing AuditOrder
# queue, then email a deterministic analytics summary. Deployed as its
# own Railway service (Cron Schedule) — see
# docs/MARKET_STUDY_DAILY_AUTOMATION.md. Disabled = completely inert;
# nothing here changes the manual Market Study flow, scoring, or the
# audit worker.
MARKET_STUDY_DAILY_AUTOMATION_ENABLED="false"
# Target businesses/day (clamped 1-200 in code).
MARKET_STUDY_DAILY_BATCH_SIZE="50"
# Hour of day (UTC, 0-23) the kickoff is allowed to fire.
MARKET_STUDY_DAILY_RUN_HOUR_UTC="13"
# Comma-separated rotation lists. Required for the automation to do
# anything — deterministic by calendar day (dayIndex % list.length),
# no rotation position is persisted.
MARKET_STUDY_DAILY_INDUSTRIES=""
MARKET_STUDY_DAILY_LOCATIONS=""
# Which discovery provider to use — must match a name in
# src/lib/discovery/registry.ts and have its own API key configured
# (see OUTSCRAPER_API_KEY / GOOGLE_PLACES_API_KEY above).
MARKET_STUDY_DAILY_DISCOVERY_PROVIDER="outscraper"
# Parallel qualifyLead() calls during kickoff (bounded 1-10).
MARKET_STUDY_DAILY_QUALIFY_CONCURRENCY="3"
# Kickoff-stage retries on a transient failure (e.g. provider outage).
# Does NOT affect the worker's own audit-level retry logic.
MARKET_STUDY_DAILY_MAX_RETRIES="3"
# Optional daily cost ceiling in USD — trims the batch using the same
# estimateBatchCost() the manual Market Study UI already shows.
# Unset = no ceiling.
MARKET_STUDY_DAILY_COST_CEILING_USD=""
# Summary-email recipient. Falls back to AUDIT_NOTIFICATION_EMAIL when
# unset.
MARKET_STUDY_DAILY_RECIPIENT_EMAIL=""

# ── Future module flags (scaffold; disabled by default) ────────────────
# Gate the placeholder routes under src/app/(future)/ and any future
# scheduled jobs for the src/modules/* scaffolds documented in
# docs/GEOVIZ_PLAYBOOK.md and docs/architecture/SYSTEM_ARCHITECTURE.md.
# CURRENT STATE: no code path other than the five src/app/(future)/*
# placeholder routes reads these. Leave unset/"false" — setting any of
# these to "true" only unhides a static, non-functional skeleton page;
# it does not enable any real feature.
GEO_MODULE_MONITORING_ENABLED="false"
GEO_MODULE_COMPETITOR_INTELLIGENCE_ENABLED="false"
GEO_MODULE_VISIBILITY_LAYER_ENABLED="false"
GEO_MODULE_WORDPRESS_PLUGIN_ENABLED="false"
GEO_MODULE_SHOPIFY_PLUGIN_ENABLED="false"
GEO_MODULE_AGENCY_PLATFORM_ENABLED="false"
GEO_MODULE_ENTERPRISE_ENABLED="false"
GEO_MODULE_BENCHMARK_ENGINE_ENABLED="false"
GEO_MODULE_DATA_LICENSING_ENABLED="false"
GEO_MODULE_AI_ANSWER_SAMPLING_ENABLED="false"
GEO_MODULE_CHANGE_DETECTION_ENABLED="false"
GEO_MODULE_ALERTS_ENABLED="false"
GEO_MODULE_TELEMETRY_ENABLED="false"
GEO_MODULE_COHORT_ANALYSIS_ENABLED="false"

# ── Calibration Engine (learning loop) ──────────────────────────────────
# NOT one of the dormant scaffolds above — this gates a real, additive
# extension of the already-live /admin/calibration cockpit (see
# src/lib/calibration/, scripts/calibration-batch-runner.ts). Disabled by
# default. Enabling only affects `npm run calibration:batch` (which
# otherwise exits immediately with zero writes) and the new dashboard
# panel's data-fetching — it never touches the worker, scoring, or any
# customer-facing route.
GEO_MODULE_CALIBRATION_ENGINE_ENABLED="false"
# Audits per learning-loop batch. Configurable per the product spec;
# 25 is the shipped default.
GEO_CALIBRATION_BATCH_SIZE="25"
