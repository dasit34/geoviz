generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum AuditStatus {
  pending
  completed
}

model AuditOrder {
  id                         String        @id @default(cuid())
  websiteUrl                 String
  email                      String
  businessName               String?
  competitorUrl              String?
  stripeSessionId            String        @unique
  amount                     Int           @default(9700)
  currency                   String        @default("usd")
  paymentStatus              PaymentStatus @default(pending)
  auditStatus                AuditStatus   @default(pending)
  notes                      String?
  adminEmailSentAt           DateTime?
  reportStatus               String        @default("pending")
  reportMarkdown             String?
  reportError                String?
  reportQueuedAt             DateTime?
  reportStartedAt            DateTime?
  reportGeneratedAt          DateTime?
  reportSentToCustomerAt     DateTime?
  reviewStatus               String        @default("pending")
  adminNotes                 String?
  qualityScore               Int?
  sentTo                     String?
  sentCc                     String?
  customerConfirmationSentAt DateTime?
  // Operational state model (added to disambiguate infrastructure
  // failures from audit outcomes). See `src/lib/processing-status.ts`
  // for the full taxonomy and the derive function consumed by the
  // admin queue UI. The legacy `reportStatus` column stays as the
  // canonical state machine; `failureReason` adds the granular
  // operator-facing category when reportStatus = "failed". The legacy
  // `reportError` column keeps the full error text for debugging.
  failureReason              String?
  retryCount                 Int           @default(0)
  lastRetryAt                DateTime?
  // Token + cost tracking (Phase 1 — visibility only, no behavioural
  // change). Captured from `response.usage` after each Anthropic API
  // call. estimatedCostUsd is computed via `src/lib/pricing.ts`. All
  // nullable so historic rows without usage data still validate.
  // See COST_AND_USAGE_TRACKING.md for the cost model + roadmap.
  inputTokens                Int?
  outputTokens               Int?
  cacheCreationTokens        Int?
  cacheReadTokens            Int?
  modelUsed                  String?
  estimatedCostUsd           Decimal?      @db.Decimal(10, 6)
  // Worker runtime captured at audit completion (the wrapper's
  // elapsedMs — full Anthropic API call + tool-use round-trips).
  // Stored as INT milliseconds. Null for historic rows, CLI-mode
  // runs, and failed/in-flight audits that never reached the
  // success path.
  workerRuntimeMs            Int?
  // Customer-facing failure notification timestamp. Set when the worker
  // sends either the "delayed" or "failed" customer email so we never
  // double-send on a retry pass through the same terminal state. Null
  // when the order is healthy / queued / completed. See
  // `src/lib/customer-emails.ts` and `src/lib/customer-failure-mapping.ts`.
  customerFailureNotifiedAt  DateTime?
  // Groups all AuditOrder rows created by one Launch QA batch submission.
  // Null on historic rows and customer orders. Populated by the calibration
  // POST route when queuing a batch via the Launch QA tool.
  calibrationBatchId         String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  intelligence AuditIntelligence?
  // Append-only history of observation runs for this audit.
  // Multi-row (re-audits add rows) — distinct from the 1:1
  // `intelligence` relation. See `src/lib/observations/history/`.
  observationHistory ObservationHistory[]
  // Append-only history of calibration replay runs. Each row is one
  // operator-triggered replay; we never mutate or overwrite. See
  // `src/lib/calibration/replays.ts`.
  calibrationReplays CalibrationReplay[]

  @@index([email])
  @@index([createdAt])
}

/// Append-only history of observation-layer runs.
///
/// One row per `executeObservation()` invocation that landed
/// through the gate. NEVER updated, NEVER overwritten — to revise,
/// insert a new row. Stamps the deterministic scoring hashes
/// (`weightHash` + `categoryHash`) at write time so an analyst can
/// prove scoring was unchanged when this row was written.
///
/// Foreign key to `AuditOrder` with `ON DELETE CASCADE` — if the
/// audit row is purged, its observation history goes with it.
model ObservationHistory {
  id                String     @id @default(cuid())
  auditId           String
  auditOrder        AuditOrder @relation(fields: [auditId], references: [id], onDelete: Cascade)

  providerCount     Int
  agreementScore    Int        // 0..100 from computeAgreement
  variance          Float      // max stdev across the 4 signal dimensions
  observationStatus String     // "OK" | "DISAGREE" | "SUPPRESSED" | "SINGLE_PROVIDER"
  providerNames     Json       // string[] of ObservationProviderIds, stable order
  estimatedCost     Decimal    @db.Decimal(10, 6)
  avgLatency        Int        // ms — round(mean(success.latency_ms))

  // Freeze-contract evidence copied from frozen.ts at write time.
  scoringVersion    String     // "scoring@1.0.0"
  weightHash        String     // frozen.WEIGHT_HASH
  categoryHash      String     // frozen.CATEGORY_HASH

  createdAt         DateTime   @default(now())

  @@index([auditId])
  @@index([createdAt])
}

/// Append-only history of calibration replay runs.
///
/// Each row is one `scripts/replay-audits.ts --persist` execution
/// against a stored audit. NEVER updated, NEVER overwritten — to
/// revise, insert a new row. Records the headline delta + drift
/// status plus optional drill-down payload (per-category deltas,
/// changed findings) so operators can audit calibration over time
/// without re-running the (expensive) audit pipeline.
///
/// Mirrors the ObservationHistory pattern: cuid PK, indexed auditId
/// + createdAt, foreign-key cascade. Adds a third index on
/// replayStatus for the cockpit's filter pills.
model CalibrationReplay {
  id                  String     @id @default(cuid())
  auditId             String
  auditOrder          AuditOrder @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Headline fields surfaced in the cockpit table.
  originalScore       Int?
  recalculatedScore   Int?
  delta               Int?
  previousBand        String?    // e.g. "Needs Work"
  currentBand         String?
  bandChanged         Boolean    @default(false)
  replayStatus        String     // "stable" | "minor_drift" | "major_drift" | "band_moved" | "hash_mismatch" | "partial_replay" | "unreplayable"
  runtimeMs           Int
  replayMode          String     // "stored" | "skip" | "live"

  // Freeze-contract evidence (matches ObservationHistory pattern).
  scoringVersion      String?    // "scoring@1.0.0" stamp from the original audit run
  weightHashMatch     Boolean?   // null when no replayBundle was available (partial_replay)
  categoryHashMatch   Boolean?
  // Actual hash values stamped at the original audit time. Lets
  // analysts query lineage patterns ("all drift from rows stamped
  // with weight_hash=abc123") without re-running anything. Null
  // for replays whose source row predates the replayBundle column
  // OR for partial_replay fallback rows.
  weightHashOriginal  String?
  categoryHashOriginal String?

  // Drill-down payload (optional, lazy-loaded by the inline panel).
  // Shape per src/lib/calibration/replays.ts CategoryDeltas + ChangedFindings types.
  categoryDeltas      Json?
  changedFindings     Json?

  createdAt           DateTime   @default(now())

  @@index([auditId])
  @@index([createdAt])
  @@index([replayStatus])
}

/// V2 data foundation — normalized intelligence row written once per
/// generated audit. NOT customer-facing. NOT exposed via any public
/// route. Written by `scripts/geo-worker.ts` via
/// `src/lib/audit-intelligence.ts` immediately after the customer
/// report-markdown write succeeds, inside its own try/catch so a
/// failure here never breaks the customer report flow.
///
/// Fields the V1 audit engine doesn't yet produce are deliberately
/// nullable — we store null over fake precision. V2 modules
/// (benchmarking, calibration, historical tracking, competitor
/// comparison, recurring monitoring, crawler intelligence) will read
/// from this table without coupling to V1 implementation details.
model AuditIntelligence {
  id           String     @id @default(cuid())
  auditOrderId String     @unique
  auditOrder   AuditOrder @relation(fields: [auditOrderId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  // Identity (denormalized for V2 query speed)
  businessName     String?
  websiteUrl       String
  /// DEPRECATED — superseded by `industryCategoryRaw` +
  /// `industryCategoryNormalized` + `industryTaxonomyVersion`. Kept
  /// nullable + always-null in V1 so we don't need a drop migration
  /// right now. A future cleanup can drop this column once we're
  /// confident no historic data exists in it.
  industryCategory String?
  location         String?
  competitorUrl    String?

  // Industry taxonomy (V2 benchmarking). Three columns kept together:
  //   - raw: the unnormalized value as detected / entered.
  //   - normalized: the canonical taxonomy slug (see
  //     `src/lib/intelligence/industry-taxonomy.ts`).
  //   - version: lets a future taxonomy rev (v2, v3…) coexist with
  //     historic rows without corrupting old benchmark cohorts.
  industryCategoryRaw        String?
  industryCategoryNormalized String?
  industryTaxonomyVersion    String  @default("v1")

  // Scores — all 0..100 normalized. null when the rubric category
  // wasn't parseable from the audit markdown.
  overallScore                 Int?
  semanticClarityScore         Int?
  crawlerAccessibilityScore    Int?
  trustSignalScore             Int?
  structuredIdentityScore      Int?
  recommendationReadinessScore Int?
  renderabilityScore           Int?

  // Technical signals — currently nullable placeholders. V1 engine
  // doesn't reliably detect any of these; V2 crawler module will.
  schemaDetected    Boolean?
  llmsTxtDetected   Boolean?
  robotsTxtDetected Boolean?
  sitemapDetected   Boolean?
  mobileRenderOk    Boolean?
  pagesIndexable    Boolean?

  // Categorizations (Postgres jsonb via Prisma Json). Always written
  // (can be empty arrays) so V2 queries can ARRAY_LENGTH safely.
  aiReadabilityFlags    Json
  majorIssueCategories  Json
  majorFixCategories    Json
  topObservedStrengths  Json
  topObservedWeaknesses Json

  // Calibration / versioning
  confidenceLevel    String // "low" | "medium" | "high"
  auditEngineVersion String
  scoringVersion     String
  promptVersion      String?
  operatorReviewed   Boolean @default(false)
  operatorNotes      String?
  rawSignalSnapshot  Json

  // V2 Stage 1 — Intelligence Stabilization fields. All nullable.
  // Populated post-audit by `src/lib/intelligence/intelligenceIngest.ts`
  // in a fail-soft try/catch. NOT consumed by scoring, NOT consumed by
  // report rendering. Pre-Stage-1 rows stay null on every field below.
  cmsDetected         String?    // e.g. "shopify" | "wordpress" | "wix" | "squarespace"
  frameworkDetected   String?    // e.g. "nextjs" | "react" | "vanilla" | "vue"
  schemaTypes         Json?      // string[] — detected schema.org types
  aiReadabilityScore  Int?       // 0..100 composite heuristic
  contentDensity      Int?       // approximate words per discoverable page
  // Render-required is a heuristic flag for future browser-rendering work.
  // Stage 1 ships the flags only; no browser infrastructure yet. The three
  // render* columns stay null on every row until Stage 6 (post-launch).
  renderRequired      Boolean?
  renderAttempted     Boolean?
  renderSuccessful    Boolean?
  renderEngineVersion String?
  // benchmarkTags is SYSTEM-set (Json array), distinct from the existing
  // `benchmarkTag` scalar which is OPERATOR-set (calibration intelligence).
  // Both can coexist; the system-set array is for automated cohort tags
  // like "high_js_density" / "thin_content" / etc.
  benchmarkTags       Json?
  extractedEntities   Json?      // string[] — business names, services, locations
  // Score provenance — per-dimension reasons + signals for explainability.
  // Shape: { schema: { score, reasons[], signals[] }, crawlability: …,
  //          trust: …, content: …, aiReadability: …, recommendationReadiness: … }
  // See `src/lib/intelligence/scoreProvenance.ts` for the type.
  scoreProvenance     Json?

  // Operator-judgment calibration intelligence — structured fields
  // captured when an operator manually reviews an audit. NOT machine
  // learning, NOT self-modifying. Pure operator memory. See
  // `src/lib/intelligence/calibration.ts` for the type taxonomy +
  // summary helpers.
  //
  //   operatorVerdict    — accurate / slightly_high / too_high /
  //                        slightly_low / too_low. Null when not yet
  //                        tagged.
  //   operatorConfidence — high / medium / low. The OPERATOR's
  //                        confidence in the score (distinct from
  //                        `confidenceLevel` above, which is the
  //                        parser's confidence in the rubric extraction).
  //   benchmarkTag       — excellent_example / average_example /
  //                        weak_example / edge_case. For curating a
  //                        future benchmark dataset.
  //   calibrationNotes   — freeform operator memo. Distinct from
  //                        `operatorNotes` so calibration context
  //                        stays separable from general review notes.
  operatorVerdict    String?
  operatorConfidence String?
  benchmarkTag       String?
  calibrationNotes   String?

  // ─── V2 Stage 2 — Render intelligence (optional, additive) ──────
  // Populated by the optional post-ingest render pass in
  // `src/lib/intelligence/render/renderIntelligence.ts`. NEVER blocks
  // audit completion: render is gated by `GEO_RENDER_ENABLED` AND a
  // multi-signal eligibility check. Render failure stores
  // `renderFailureReason` and leaves successful-render fields null.
  //
  // Render intelligence is operator/admin/calibration data only —
  // NOT consumed by scoring, NOT shown to customers in V1/V2. Stage 6+
  // may consider feeding renderability findings back into the score
  // weighting; until then, treat these columns as research surface.
  renderDurationMs           Int?
  renderedHtmlLength         Int?
  renderedTextLength         Int?
  renderedSchemaTypes        Json?    // string[] — schema.org types found after render
  hydrationDetected          Boolean?
  blankShellRisk             Boolean? // true when raw HTML is mostly empty shell
  clientOnlyContentDetected  Boolean? // true when rendered content >> raw content
  renderConfidence           String?  // "low" | "medium" | "high"
  renderFailureReason        String?
  // Raw-vs-rendered comparison snapshot. `rawTextLength` and
  // `rawSchemaTypes` are captured pre-render so a future analyst can
  // diff without re-fetching the source page.
  rawTextLength              Int?
  rawSchemaTypes             Json?    // string[]
  schemaDeltaDetected        Boolean? // true when renderedSchemaTypes ⊋ rawSchemaTypes
  contentDeltaDetected       Boolean? // true when renderedTextLength / rawTextLength > threshold

  // ─── V2 Preflight intelligence ──────────────────────────────────
  // Populated post-audit by `src/lib/intelligence/preflight/runPreflight.ts`
  // in a fail-soft try/catch alongside the Stage 1 ingest. Captures
  // Node-side structured signals that the Claude prompt can't reliably
  // produce: parsed JSON-LD entity field validation, direct
  // robots.txt / sitemap.xml / canonical / meta-robots inspection,
  // and name/phone/address consistency across homepage + footer +
  // schema. Not consumed by scoring, not shown to customers — V2
  // research surface only. Pre-preflight rows stay null.
  preflightSignals           Json?

  // ─── V2 Deterministic scoring (scoring@1.0.0) ───────────────────
  // Populated by `src/lib/scoring/scoreAudit()` from preflight +
  // ingest + render evidence. The single source of truth for the
  // overall score on new audits — the LLM no longer produces or
  // reconciles numbers. Shape: `DeterministicScore` from
  // `src/lib/scoring/types.ts`. Legacy rows (pre-`scoring@1.0.0`)
  // stay null and the resolver in
  // `src/lib/scoring/getCanonicalScore.ts` falls back to
  // `parseReportScoreBreakdown(reportMarkdown)`.
  deterministicScore         Json?

  // Self-contained replay snapshot per audit. Populated by the
  // deterministic scoring block in `src/lib/audit-intelligence.ts`
  // alongside `deterministicScore`. Holds the inputs (preflight +
  // ingest + render + history), the gathered `Evidence`, the full
  // `DeterministicScore` output, the freeze hashes, and a
  // `computed_at` timestamp — enough to call `scoreAudit()` again
  // and recover the same score byte-equal. Shape: `ReplayBundle`
  // from `src/lib/scoring/replay-bundle.ts`. Historical rows stay
  // null — no backfill.
  replayBundle               Json?

  // ─── Cross-Model Consensus layer (consensus@1.0.0) ──────────────
  // Raw validator outputs preserved internally. Shape:
  // `ValidationLayerResult` from `src/lib/validators/types.ts`.
  // Populated only when `ENABLE_CONSENSUS_PIPELINE=true` and at
  // least one validator returned. `null` when the validator step
  // failed entirely (fail-soft) or the feature flag is off.
  aiValidations              Json?

  // Customer-facing intelligence synthesis. Shape: `ConsensusIndex`
  // from `src/lib/consensus/types.ts`. SECONDARY to
  // `deterministicScore` — the deterministic score with its frozen
  // bands stays primary. Computed deterministically from
  // `deterministicScore.category_scores` (dimension roll-ups) plus
  // cross-model agreement metrics from `aiValidations`. Validator
  // outputs DO NOT enter the confidence_index number — only the
  // model_agreement + consensus_confidence labels.
  consensusIndex             Json?

  @@index([createdAt])
  @@index([websiteUrl])
}
