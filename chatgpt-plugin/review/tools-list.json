[
  {
    "name": "check_business_visibility",
    "title": "Check website AI-readiness",
    "description": "Run GeoViz's free website AI-readiness check on a business's public homepage. For local service businesses and online/software businesses it returns a 0-100 readiness score, six category findings, up to three prioritized improvements, supporting evidence, and the check date. Publishers, online stores, and sites whose type can't be determined reliably are recognized but not scored (score null, no improvements). It analyzes the website only — it does not ask any AI system whether it recommends the business.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "websiteUrl": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "The business website to check, e.g. https://example.com"
        },
        "businessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Business name as customers know it (improves the identity check)"
        },
        "city": {
          "type": "string",
          "maxLength": 100,
          "description": "City the business serves"
        },
        "state": {
          "type": "string",
          "maxLength": 100,
          "description": "State or region the business serves"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "What kind of business it is, e.g. roofing contractor, dental clinic, or invoicing software (improves classification)"
        }
      },
      "required": [
        "websiteUrl"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://geoviz/visibility-card-v1.html"
      },
      "openai/outputTemplate": "ui://geoviz/visibility-card-v1.html",
      "openai/toolInvocation/invoking": "Checking website AI-readiness…",
      "openai/toolInvocation/invoked": "Website check complete"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "checkType": {
          "type": "string",
          "const": "website_ai_readiness"
        },
        "business": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "nameProvided": {
              "type": "boolean"
            },
            "city": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "nameProvided",
            "city",
            "state"
          ],
          "additionalProperties": false
        },
        "businessType": {
          "type": "string",
          "enum": [
            "local",
            "online",
            "uncertain",
            "insufficient_evidence",
            "publisher",
            "ecommerce"
          ]
        },
        "websiteChecked": {
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "scoreLabel": {
          "type": "string",
          "enum": [
            "Website AI-readiness (free check)",
            "Not scored — outside GeoViz's supported business types",
            "Not scored — website type could not be determined reliably"
          ]
        },
        "scopeNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "strong",
                  "needs_improvement",
                  "missing",
                  "not_applicable"
                ]
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "status",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "priorityImprovements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkedAt": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "properties": {
            "freeCheck": {
              "type": "string"
            },
            "exampleReport": {
              "type": "string"
            }
          },
          "required": [
            "freeCheck",
            "exampleReport"
          ],
          "additionalProperties": false
        },
        "aiSystemsQueried": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "disclaimer": {
          "type": "string",
          "const": "This is a website AI-readiness check of public pages. GeoViz did not ask ChatGPT, Claude, Gemini, or Perplexity about this business; it does not show whether any AI system recommends it."
        }
      },
      "required": [
        "checkType",
        "business",
        "businessType",
        "websiteChecked",
        "score",
        "scoreLabel",
        "scopeNote",
        "findings",
        "priorityImprovements",
        "evidence",
        "checkedAt",
        "links",
        "aiSystemsQueried",
        "disclaimer"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
]
